---
import Base from './Base.astro';

interface Props {
	pageTitle: string;
	class?: string;
}

const { pageTitle, class: className } = Astro.props;
---

<Base {pageTitle}>
	<main
		class:list={["layout-base gap-unrelated-tight pt-margins-tight pb-unrelated flex-1", className]}
	>
		<slot />
	</main>
</Base>
