---
import { getEntry, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

import { MainLayout } from '#/layouts';
import { getPageNavigationEntries } from '#/lib/content/getters';

export const getStaticPaths = (async () => {
	const pageNavigationEntries = await getPageNavigationEntries();

	const pagesEntries = await Promise.all(
		pageNavigationEntries.map((entry) => getEntry('pages', entry.page.id)),
	);

	const pages = pagesEntries.filter(
		(page): page is NonNullable<typeof page> => page !== undefined,
	);

	return pages.map((page) => ({
		params: { pages: page.id },
		props: { page },
	}));
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { Content } = await render(page);
---

<MainLayout pageTitle={page.data.title} class="layout-prose">
	<div class="prose prose-custom">
		<Content />
	</div>
</MainLayout>
